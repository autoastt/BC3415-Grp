# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-...
# Needed when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ---- Models ----
ANTHROPIC_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
MAX_ANSWER_TOKENS=600

# ---- Embeddings: openai | local ----
# Switching provider/model creates a fresh collection; re-add your sources afterwards.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# For local: uncomment sentence-transformers in backend/requirements.txt
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- App ----
APP_NAME=ScopeGuard
# Protects the Knowledge Base tab and settings. Strongly recommended anywhere public.
ADMIN_TOKEN=change-me-to-a-long-random-string
SEED_SAMPLE_DATA=true

# ---- RAG tuning ----
RELEVANCE_THRESHOLD=0.35
TOP_K=5
CHUNK_TOKENS=500
CHUNK_OVERLAP=50
HISTORY_MESSAGES=6

# ---- Limits ----
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=20
MAX_SCRAPE_MB=5
MAX_MESSAGE_CHARS=1000
# Local dev only: allow scraping localhost / private IPs
ALLOW_PRIVATE_URLS=false
CORS_ORIGINS=http://localhost:5173
